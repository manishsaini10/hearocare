{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearocare",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "PAGE_DATA",
      "id": "hearocare_cms_data"
    }
  ]
}
